doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    block title
    title
      if title
        = title
      else
        | Ava Dance Academy
    link(rel="stylesheet", href="/static/style.css")
    block style
  body
    header
      nav#navbar
        .nav-top
          a#logo(href="/")
            img(src="/static/img/logo.png", alt="HDA logo")
            span HDA
          button#menuToggle(type="button", aria-label="Toggle navigation") ☰
        ul#navList
          li: a(href="/") Home
          li: a(href="/about") About
          li: a(href="/services") Services
          li: a(href="/classes") Class Info
          li: a(href="/contact") Contact Us
    main
      block content
    footer#footer
      p Copyright © 2019 AvaDanceAcademy.com | All rights reserved
    script(src="/static/index.js")
    block scripts