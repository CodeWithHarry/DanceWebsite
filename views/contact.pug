extends base.pug

block title
  | Contact Us | Ava Dance Academy

block style
  style
    include ../static/styleContact.css

block content
  .container
    h1 Contact Us
    if message
      .status-message(class=status)= message
    form(action="/contact", method="post", class="myForm", id="contactForm")
      .form-row
        input(type="text", name="name", placeholder="Enter your name", class="myInput#{errors.name ? ' input-error' : ''}", value=formData.name || '')
        if errors.name
          p.error= errors.name
      .form-row
        input(type="tel", name="phone", placeholder="Enter your phone number", class="myInput#{errors.phone ? ' input-error' : ''}", value=formData.phone || '')
        if errors.phone
          p.error= errors.phone
      .form-row
        input(type="email", name="email", placeholder="Enter your email id", class="myInput#{errors.email ? ' input-error' : ''}", value=formData.email || '')
        if errors.email
          p.error= errors.email
      .form-row
        input(type="text", name="address", placeholder="Enter your address", class="myInput#{errors.address ? ' input-error' : ''}", value=formData.address || '')
        if errors.address
          p.error= errors.address
      .form-row
        textarea(name="desc", placeholder="Enter your concern", class="myInput#{errors.desc ? ' input-error' : ''}") #{formData.desc || ''}
        if errors.desc
          p.error= errors.desc
      button(type="submit", class="btn") Submit